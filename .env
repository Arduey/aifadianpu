# ═════════════════════════════════════════════════════════
# 爱发电铺 · 环境变量模板(随仓库分发)
#
# ⚠️ 本文件是「空模板」,请勿把真实密码/SECRET 提交进 git。
#    部署时:复制本文件为 .env 并填写,或直接走「/install 安装向导」
#    (向导会自动生成包含真实值的 .env,无需手工编辑)。
#
#    填写后请**不要**再 commit 本文件,否则数据库密码会永久留在 git 历史里。
# ═════════════════════════════════════════════════════════

# ── 数据库连接(必填) ──
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# ── 会话与安全 ──
# SESSION_SECRET 用于签发登录 cookie,必须是 64 位随机 hex。
# 生成:python3 -c "import secrets;print(secrets.token_hex(32))"
# ⚠️ 多站点部署时,各站的 SESSION_SECRET 必须互不相同,否则 cookie 可互相解签而串号。
SESSION_SECRET=
APP_SECURE=true

# ── 站点地址 ──
# 留空则下单/回调链接用默认 http://localhost:8000,生产环境请填真实域名。
APP_BASE_URL=

# ── SMTP(可选,用于发订单号/卡密邮件) ──
# ⚠️ SMTP_FROM 必须与已认证账号一致,否则邮箱商会以伪域拒收(550)。
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=爱发电铺

# ── 遗留项(当前代码已不读取,留空/不设即可) ──
AFDIAN_LIVE=false
ENABLE_PREVIEW_LOGIN=false
