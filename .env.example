# ═════════════════════════════════════════════════════════
# 爱发电铺 · 环境变量(参考)
#
# 重要:部署**无需手动编辑本文件**。
# 所有配置(数据库连接、会话密钥、SMTP、平台账号等)都在
# 「/install 安装向导」里网页填写,并由向导自动生成 .env。
# 本文件仅列出可能出现的键,供参考/排查。
# ═════════════════════════════════════════════════════════

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=afdianpu

SESSION_SECRET=            # 安装向导自动生成
APP_SECURE=true

# ⚠️ 遗留项:当前业务代码已不读取,留空/不设即可(下单/查单固定走真实接口)。
AFDIAN_LIVE=false
ENABLE_PREVIEW_LOGIN=false
APP_BASE_URL=

SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=爱发电铺
